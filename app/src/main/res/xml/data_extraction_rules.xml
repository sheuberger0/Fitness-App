<?xml version="1.0" encoding="utf-8"?>
<!-- Android-Backup ab Android 12: Cloud-Backup und Übertragung auf ein neues Gerät enthalten die Datenbank. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
